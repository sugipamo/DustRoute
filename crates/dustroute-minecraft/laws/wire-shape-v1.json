                  "op": "input",
                  "name": "upper_wire"
                },
                "right": {
                  "op": "not",
                  "value": {
                    "op": "input",
                    "name": "blocked"
                  }
                }
              }
            },
            "then": [
              {
                "op": "set",
                "register": "shape",
                "value": {
