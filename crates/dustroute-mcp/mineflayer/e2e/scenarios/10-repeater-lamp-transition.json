{
  "name": "repeater_and_lamp_transition",
  "steps": [
    { "kind": "command", "commands": [
      "/fill 539 103 -1 546 108 1 minecraft:air",
      "/fill 540 103 0 544 103 0 minecraft:stone",
      "/setblock 540 104 0 minecraft:lever[face=floor,facing=east,powered=false]",
      "/setblock 541 104 0 minecraft:redstone_wire",
      "/setblock 542 104 0 minecraft:repeater[facing=west,delay=2,locked=false,powered=false]",
      "/setblock 543 104 0 minecraft:redstone_wire",
      "/setblock 544 104 0 minecraft:redstone_lamp[lit=false]"
    ]},
    { "kind": "aim", "position": { "x": 540.5, "y": 106, "z": 6.5 }, "target": { "x": 540, "y": 103, "z": 0 } },
    { "kind": "mcp", "tool": "new_transition_test", "arguments": { "max_components": 64, "observation_ticks": 16 }, "save": "proposal" },
    { "kind": "assert", "from": "proposal", "expect": [
      { "path": "proposals.0.safety.safety", "equals": "ready" }
    ]},
    { "kind": "mcp", "tool": "show_operation", "arguments": { "operation_id": "${proposal.proposals.0.operation_id}" }, "save": "preview" },
    { "kind": "mcp", "tool": "invoke_operation", "arguments": { "operation_id": "${proposal.proposals.0.operation_id}", "confirm": true }, "save": "run" },
    { "kind": "assert", "from": "run", "expect": [
      { "path": "ok", "equals": true },
      { "path": "recording.stored_events", "at_least": 4 },
      { "path": "scenario_verification.live_trace.events.5.redstone_tick", "at_least": 1 },
      { "path": "scenario_verification.live_trace.final_powered.4.powered", "equals": true },
      { "path": "scenario_verification.steady_state_equivalent", "equals": true },
      { "path": "scenario_verification.live_trace.final_powered.0.position", "exists": true },
      { "path": "restoration.verified", "equals": true }
    ]}
  ],
  "cleanup": ["/fill 539 103 -1 546 108 1 minecraft:air"]
}
