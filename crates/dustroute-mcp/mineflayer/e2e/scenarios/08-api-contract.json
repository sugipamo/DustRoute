{
  "name": "api_error_contract",
  "steps": [
    { "kind": "mcp_error", "tool": "invoke_operation", "arguments": { "operation_id": "not-a-uuid", "confirm": true }, "save": "error" },
    { "kind": "assert", "from": "error", "expect": [
      { "path": "ok", "equals": false },
      { "path": "schema_version", "equals": "dustroute.error.v1" },
      { "path": "error_code", "equals": "invalid_argument" },
      { "path": "retryable", "equals": false },
      { "path": "error", "exists": true }
    ]},
    { "kind": "mcp", "tool": "get_bot_status", "arguments": {}, "save": "status" },
    { "kind": "assert", "from": "status", "expect": [
      { "path": "ok", "equals": true }
    ]}
  ]
}
