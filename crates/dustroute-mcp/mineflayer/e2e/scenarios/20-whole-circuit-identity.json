{
  "name": "whole_circuit_identity",
  "steps": [
    { "kind": "command", "commands": [
      "/fill 799 102 -1 852 109 25 minecraft:air",
      "/setblock 800 103 0 minecraft:stone"
    ]},
    { "kind": "aim", "position": { "x": 800.5, "y": 106, "z": 6.5 }, "target": { "x": 800, "y": 103, "z": 0 } },
    { "kind": "mcp", "tool": "new_placement", "arguments": {
      "circuit": "half-adder",
      "max_blocks": 4096,
      "optimize": false
    }, "save": "plan" },
    { "kind": "mcp", "tool": "show_operation", "arguments": {
      "operation_id": "${plan.operation_id}"
    }, "save": "preview" },
    { "kind": "mcp", "tool": "invoke_operation", "arguments": {
      "operation_id": "${plan.operation_id}", "confirm": true
    }, "save": "apply" },
    { "kind": "assert", "from": "apply", "expect": [
      { "path": "ok", "equals": true },
      { "path": "verified", "equals": true }
    ]},
    { "kind": "aim", "position": { "x": 794.5, "y": 107, "z": 8.5 }, "target": { "x": 801, "y": 106, "z": 8 } },
    { "kind": "mcp", "tool": "convert_from_circuit", "arguments": {
      "max_components": 512,
      "fragment_gap": 16,
      "include_truth_table": true
    }, "save": "identity" },
    { "kind": "assert", "from": "identity", "expect": [
      { "path": "ok", "equals": true },
      { "path": "analysis_complete", "equals": true },
      { "path": "circuit_identity.classification_level", "equals": "higher_function" },
      { "path": "circuit_identity.primary_candidate.kind", "equals": "half_adder" },
      { "path": "circuit_identity.primary_candidate.basis", "equals": "inferred_truth_table" },
      { "path": "circuit_identity.primary_candidate.input_count", "equals": 2 },
      { "path": "circuit_identity.primary_candidate.output_count", "equals": 2 },
      { "path": "circuit_identity.analysis_complete", "equals": true }
    ]},
    { "kind": "wait", "ticks": 20 },
    { "kind": "mcp", "tool": "undo_operation", "arguments": {
      "operation_id": "${plan.operation_id}", "confirm": true
    }, "save": "undo" },
    { "kind": "assert", "from": "undo", "expect": [
      { "path": "ok", "equals": true },
      { "path": "verified", "equals": true }
    ]}
  ],
  "cleanup": ["/fill 799 102 -1 852 109 25 minecraft:air"]
}
