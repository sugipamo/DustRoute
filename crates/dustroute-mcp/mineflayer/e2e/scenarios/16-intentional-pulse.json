{
  "name": "intentional_pulse_contract",
  "steps": [
    { "kind": "command", "commands": [
      "/fill 659 103 -1 665 108 1 minecraft:air",
      "/fill 660 103 0 663 103 0 minecraft:stone",
      "/setblock 660 104 0 minecraft:lever[face=floor,facing=east,powered=false]",
      "/fill 661 104 0 663 104 0 minecraft:redstone_wire"
    ]},
    { "kind": "aim", "position": { "x": 660.5, "y": 106, "z": 6.5 }, "target": { "x": 660, "y": 103, "z": 0 } },
    { "kind": "mcp", "tool": "test_circuit", "arguments": { "max_components": 64 }, "save": "circuit" },
    { "kind": "mcp", "tool": "new_transition_test", "arguments": { "circuit_id": "${circuit.circuit_id}", "observation_ticks": 14 }, "save": "proposal" },
    { "kind": "mcp", "tool": "show_operation", "arguments": { "operation_id": "${proposal.proposals.0.operation_id}" }, "save": "preview" },
    { "kind": "mcp_with_commands", "tool": "invoke_operation", "arguments": {
      "operation_id": "${proposal.proposals.0.operation_id}",
      "confirm": true,
      "contracts": [{
        "x": "${proposal.proposals.0.lever.x}",
        "y": "${proposal.proposals.0.lever.y}",
        "z": "${proposal.proposals.0.lever.z}",
        "intent": "intentional_high_pulse",
        "minimum_width_ticks": 1,
        "maximum_width_ticks": 6
      }]
    }, "delay_ticks": 5, "commands": [
      "/setblock 660 104 0 minecraft:lever[face=floor,facing=east,powered=false]"
    ], "require_error": true, "save": "run" },
    { "kind": "assert", "from": "run", "expect": [
      { "path": "transient_assessment.contracts_applied", "equals": 1 },
      { "path": "transient_assessment.counts.intentional_pulse", "at_least": 1 },
      { "path": "restoration.verified", "equals": false }
    ]},
    { "kind": "mcp", "tool": "undo_operation", "arguments": { "operation_id": "${proposal.proposals.0.operation_id}", "confirm": true }, "save": "restored" },
    { "kind": "assert", "from": "restored", "expect": [
      { "path": "restoration_verified", "equals": true }
    ]}
  ],
  "cleanup": ["/fill 659 103 -1 665 108 1 minecraft:air"]
}
