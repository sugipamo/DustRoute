{
  "name": "observer_dummy_transition",
  "save_artifact": true,
  "steps": [
    { "kind": "command", "commands": [
      "/fill 558 102 -2 566 106 2 minecraft:air",
      "/fill 558 103 -2 566 103 2 minecraft:stone",
      "/setblock 560 104 0 minecraft:lever[face=floor,facing=east,powered=false]",
      "/setblock 561 104 0 minecraft:observer[facing=west,powered=false]",
      "/setblock 562 104 0 minecraft:redstone_lamp[lit=false]"
    ]},
    { "kind": "aim", "position": { "x": 566.5, "y": 106, "z": 0.5 }, "target": { "x": 562, "y": 104, "z": 0 } },
    { "kind": "mcp", "tool": "get_world", "arguments": {
      "max_components": 64,
      "component_gap": 2,
      "include_block_list": true,
      "max_listed_blocks": 64
    }, "save": "world" },
    { "kind": "assert", "from": "world", "expect": [
      { "path": "ok", "equals": true },
      { "path": "counts.redstone_candidates", "at_least": 3 },
      { "path": "counts.modeled_redstone", "at_least": 2 },
      { "path": "redstone_blocks.1.name", "equals": "minecraft:observer" },
      { "path": "redstone_blocks.1.properties.facing", "equals": "west" },
      { "path": "redstone_blocks.1.properties.powered", "equals": "false" }
    ]},
    { "kind": "mcp", "tool": "test_circuit", "arguments": { "max_components": 64, "fragment_gap": 2 }, "save": "circuit" },
    { "kind": "assert", "from": "circuit", "expect": [
      { "path": "ok", "equals": true },
      { "path": "diagnostic.observation_complete", "equals": true },
      { "path": "expansion.components_loaded", "at_least": 3 },
      { "path": "expansion.limit_reached", "equals": false },
      { "path": "diagnostic.counts.unsupported", "equals": 0 },
      { "path": "diagnostic.counts.probable_faults", "equals": 0 }
    ]},
    { "kind": "activate_trace", "position": { "x": 560, "y": 104, "z": 0 }, "actor_position": { "x": 558, "y": 104, "z": 0 }, "observe_positions": [
      { "x": 560, "y": 104, "z": 0 },
      { "x": 561, "y": 104, "z": 0 },
      { "x": 562, "y": 104, "z": 0 }
    ], "origin": { "x": 560, "y": 104, "z": 0 }, "duration_game_ticks": 20, "save": "on_trace" },
    { "kind": "assert", "from": "on_trace", "expect": [
      { "path": "activation.before_powered", "equals": false },
      { "path": "activation.after_powered", "equals": true },
      { "path": "observer_pulse", "equals": true },
      { "path": "lamp_pulse", "equals": true },
      { "path": "final_states.0,0,0.powered", "equals": true },
      { "path": "final_states.1,0,0.block_kind", "equals": "Observer" },
      { "path": "final_states.1,0,0.powered", "equals": false },
      { "path": "final_states.2,0,0.lit", "equals": false }
    ]},
    { "kind": "activate_trace", "position": { "x": 560, "y": 104, "z": 0 }, "actor_position": { "x": 558, "y": 104, "z": 0 }, "observe_positions": [
      { "x": 560, "y": 104, "z": 0 },
      { "x": 561, "y": 104, "z": 0 },
      { "x": 562, "y": 104, "z": 0 }
    ], "origin": { "x": 560, "y": 104, "z": 0 }, "duration_game_ticks": 20, "save": "off_trace" },
    { "kind": "assert", "from": "off_trace", "expect": [
      { "path": "activation.before_powered", "equals": true },
      { "path": "activation.after_powered", "equals": false },
      { "path": "observer_pulse", "equals": true },
      { "path": "lamp_pulse", "equals": true },
      { "path": "final_states.0,0,0.powered", "equals": false },
      { "path": "final_states.1,0,0.powered", "equals": false },
      { "path": "final_states.2,0,0.lit", "equals": false }
    ]}
  ],
  "cleanup": ["/fill 558 102 -2 566 106 2 minecraft:air"]
}
