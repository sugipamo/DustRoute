{
  "name": "comparator_analog_transition",
  "steps": [
    { "kind": "command", "commands": [
      "/fill 579 103 -1 586 108 1 minecraft:air",
      "/fill 580 103 0 584 103 0 minecraft:stone",
      "/setblock 580 104 0 minecraft:lever[face=floor,facing=east,powered=false]",
      "/setblock 581 104 0 minecraft:redstone_wire",
      "/setblock 582 104 0 minecraft:comparator[facing=west,mode=compare,powered=false]",
      "/setblock 583 104 0 minecraft:redstone_wire",
      "/setblock 584 104 0 minecraft:redstone_lamp[lit=false]"
    ]},
    { "kind": "aim", "position": { "x": 580.5, "y": 106, "z": 6.5 }, "target": { "x": 580, "y": 103, "z": 0 } },
    { "kind": "mcp", "tool": "new_transition_test", "arguments": { "max_components": 64, "observation_ticks": 12 }, "save": "proposal" },
    { "kind": "assert", "from": "proposal", "expect": [
      { "path": "proposals.0.safety.safety", "equals": "ready" }
    ]},
    { "kind": "mcp", "tool": "show_transition_test", "arguments": { "operation_id": "${proposal.proposals.0.operation_id}" }, "save": "preview" },
    { "kind": "mcp", "tool": "invoke_transition_test", "arguments": { "operation_id": "${proposal.proposals.0.operation_id}", "confirm": true }, "save": "run" },
    { "kind": "assert", "from": "run", "expect": [
      { "path": "ok", "equals": true },
      { "path": "recording.stored_events", "at_least": 4 },
      { "path": "scenario_verification.steady_state_equivalent", "equals": true },
      { "path": "restoration.verified", "equals": true }
    ]}
  ],
  "cleanup": ["/fill 579 103 -1 586 108 1 minecraft:air"]
}
