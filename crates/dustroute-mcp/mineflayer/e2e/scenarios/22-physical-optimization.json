{
  "name": "focused_physical_wire_optimization",
  "steps": [
    { "kind": "command", "commands": [
      "/fill 878 102 -1 887 106 3 minecraft:air",
      "/fill 879 103 0 885 103 2 minecraft:stone",
      "/setblock 879 104 0 minecraft:lever[face=floor,facing=east,powered=false]",
      "/setblock 880 104 0 minecraft:redstone_wire",
      "/setblock 880 104 1 minecraft:redstone_wire",
      "/setblock 880 104 2 minecraft:redstone_wire",
      "/setblock 881 104 2 minecraft:redstone_wire",
      "/setblock 882 104 2 minecraft:redstone_wire",
      "/setblock 883 104 2 minecraft:redstone_wire",
      "/setblock 884 104 2 minecraft:redstone_wire",
      "/setblock 884 104 1 minecraft:redstone_wire",
      "/setblock 884 104 0 minecraft:redstone_wire",
      "/setblock 885 104 0 minecraft:repeater[facing=west,delay=1,locked=false,powered=false]"
    ]},
    { "kind": "aim", "position": { "x": 885.5, "y": 106, "z": 6.5 }, "target": { "x": 885, "y": 104, "z": 0 } },
    { "kind": "mcp", "tool": "test_circuit", "arguments": {
      "max_components": 64,
      "fragment_gap": 2
    }, "save": "analysis" },
    { "kind": "mcp", "tool": "new_optimization", "arguments": {
      "circuit_id": "${analysis.circuit_id}",
      "focus": {
        "min": {
          "x": "${analysis.bounds.min.x}",
          "y": "${analysis.bounds.min.y}",
          "z": "${analysis.bounds.min.z}"
        },
        "max": {
          "x": "${analysis.bounds.max.x}",
          "y": "${analysis.bounds.max.y}",
          "z": "${analysis.bounds.max.z}"
        }
      },
      "objective": "density_then_wire_length"
    }, "save": "plan" },
    { "kind": "assert", "from": "plan", "expect": [
      { "path": "schema_version", "equals": "dustroute.optimization.v1" },
      { "path": "objective", "equals": "density_then_wire_length" },
      { "path": "outside_focus_fixed", "equals": true },
      { "path": "phase_trace.0.name", "equals": "local_density" },
      { "path": "phase_trace.1.name", "equals": "connector_recovery" },
      { "path": "phase_trace.2.name", "equals": "global_compaction" },
      { "path": "planning_policy.temporary_connector_growth_is_internal_only", "equals": true },
      { "path": "planning_policy.final_global_improvement_required", "equals": true },
      { "path": "metrics.wire_blocks_before", "equals": 9 },
      { "path": "metrics.wire_blocks_after", "equals": 5 },
      { "path": "preserved_boundary_blocks", "equals": 4 },
      { "path": "verification.temporal_requirement_preserved", "equals": true },
      { "path": "contract_assessment.satisfied", "equals": true },
      { "path": "contract_assessment.logical.state", "equals": "passed" },
      { "path": "contract_assessment.timing.state", "equals": "passed" },
      { "path": "contract_assessment.pulse.state", "equals": "passed" },
      { "path": "contract_assessment.boundary.state", "equals": "passed" },
      { "path": "contract_assessment.mutation.state", "equals": "passed" },
      { "path": "verification.transitions.case_count", "equals": 2 },
      { "path": "verification.transitions.differing_cases", "equals": 0 }
    ]},
    { "kind": "command", "commands": [
      "/setblock 879 104 0 minecraft:lever[face=floor,facing=east,powered=true]"
    ]},
    { "kind": "wait", "ticks": 4 },
    { "kind": "block", "position": { "x": 884, "y": 104, "z": 0 }, "save": "before_strength" },
    { "kind": "assert", "from": "before_strength", "expect": [
      { "path": "name", "equals": "redstone_wire" },
      { "path": "properties.power", "equals": "7" }
    ]},
    { "kind": "command", "commands": [
      "/setblock 879 104 0 minecraft:lever[face=floor,facing=east,powered=false]"
    ]},
    { "kind": "wait", "ticks": 4 },
    { "kind": "mcp_error", "tool": "invoke_operation", "arguments": {
      "operation_id": "${plan.operation_id}",
      "confirm": true
    }, "save": "unpreviewed" },
    { "kind": "assert", "from": "unpreviewed", "expect": [
      { "path": "error_code", "equals": "invalid_state" }
    ]},
    { "kind": "mcp", "tool": "show_operation", "arguments": {
      "operation_id": "${plan.operation_id}"
    }, "save": "preview" },
    { "kind": "mcp", "tool": "invoke_operation", "arguments": {
      "operation_id": "${plan.operation_id}",
      "confirm": true
    }, "save": "applied" },
    { "kind": "assert", "from": "applied", "expect": [
      { "path": "ok", "equals": true },
      { "path": "verified", "equals": true },
      { "path": "boundary_verified", "equals": true },
      { "path": "semantic_verification.equivalent", "equals": true }
    ]},
    { "kind": "block", "position": { "x": 880, "y": 104, "z": 0 }, "save": "applied_input_boundary" },
    { "kind": "block", "position": { "x": 884, "y": 104, "z": 0 }, "save": "applied_output_boundary" },
    { "kind": "block", "position": { "x": 885, "y": 104, "z": 0 }, "save": "applied_outside_device" },
    { "kind": "assert", "from": "applied_input_boundary", "expect": [
      { "path": "name", "equals": "redstone_wire" }
    ]},
    { "kind": "assert", "from": "applied_output_boundary", "expect": [
      { "path": "name", "equals": "redstone_wire" }
    ]},
    { "kind": "assert", "from": "applied_outside_device", "expect": [
      { "path": "name", "equals": "repeater" },
      { "path": "properties.facing", "equals": "west" },
      { "path": "properties.delay", "equals": "1" }
    ]},
    { "kind": "command", "commands": [
      "/setblock 879 104 0 minecraft:lever[face=floor,facing=east,powered=true]"
    ]},
    { "kind": "wait", "ticks": 4 },
    { "kind": "block", "position": { "x": 884, "y": 104, "z": 0 }, "save": "after_strength" },
    { "kind": "assert", "from": "after_strength", "expect": [
      { "path": "name", "equals": "redstone_wire" },
      { "path": "properties.power", "equals": "11" }
    ]},
    { "kind": "mcp", "tool": "undo_operation", "arguments": {
      "operation_id": "${plan.operation_id}",
      "confirm": true
    }, "save": "undone" },
    { "kind": "assert", "from": "undone", "expect": [
      { "path": "ok", "equals": true },
      { "path": "verified", "equals": true },
      { "path": "boundary_verified", "equals": true }
    ]},
    { "kind": "wait", "ticks": 4 },
    { "kind": "block", "position": { "x": 884, "y": 104, "z": 0 }, "save": "undo_strength" },
    { "kind": "assert", "from": "undo_strength", "expect": [
      { "path": "name", "equals": "redstone_wire" },
      { "path": "properties.power", "equals": "7" }
    ]},
    { "kind": "command", "commands": [
      "/setblock 879 104 0 minecraft:lever[face=floor,facing=east,powered=false]"
    ]},
    { "kind": "wait", "ticks": 4 },
    { "kind": "mcp_error", "tool": "new_optimization", "arguments": {
      "circuit_id": "${analysis.circuit_id}",
      "focus": {
        "min": {
          "x": "${analysis.bounds.min.x}",
          "y": "${analysis.bounds.min.y}",
          "z": "${analysis.bounds.min.z}"
        },
        "max": {
          "x": "${analysis.bounds.max.x}",
          "y": "${analysis.bounds.max.y}",
          "z": "${analysis.bounds.max.z}"
        }
      },
      "objective": "density_then_wire_length",
      "contract": { "analog": { "preserve_strength": true } }
    }, "save": "analog_plan" },
    { "kind": "assert", "from": "analog_plan", "expect": [
      { "path": "error_code", "equals": "invalid_state" }
    ]}
  ],
  "cleanup": ["/fill 878 102 -1 887 106 3 minecraft:air"]
}
